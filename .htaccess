RewriteEngine On
Options All -Indexes

# WC WWW Redirect.
#RewriteCond %{HTTP_HOST} !^www\. [NC]
#RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# WC HTTPS Redirect (behind a reverse proxy like EasyPanel)
# Only redirect when the proxy explicitly tells us the original scheme was not https.
# This avoids 301 responses for internal health checks that don't send X-Forwarded-Proto.
RewriteCond %{HTTP:X-Forwarded-Proto} !^$ [NC]
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# WC URL Rewrite
RewriteCond %{SCRIPT_FILENAME} !-f
RewriteCond %{SCRIPT_FILENAME} !-d
RewriteRule ^(.*)$ index.php?url=$1
